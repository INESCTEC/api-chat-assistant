# ==============================
# API Keys
# ==============================

# API key for Google Gemini.
# ⚠️ Required for evaluation tasks, even if LLM_PROVIDER is not set to "gemini".
GENAI_API_KEY=""

# API key for OpenAI (only required if LLM_PROVIDER="openai").
OPENAI_API_KEY=""

# ==============================
# LLM Provider Configuration
# ==============================

# Select which LLM backend the assistant should use.
# Options:
#   - "ollama" → run locally via Ollama
#   - "gemini" → use Google Gemini (requires GENAI_API_KEY)
#   - "openai" → use OpenAI (requires OPENAI_API_KEY)
LLM_PROVIDER="ollama"

# ==============================
# API Access
# ==============================

# Token required to authenticate requests against the external API
# defined in the OpenAPI documentation.
# ⚠️ This is NOT for the assistant itself, but for calling the target API
# that the assistant integrates with.
API_TOKEN=""

# Authentication scheme used in the request headers.
# Options:
#   - "Token"   → results in: {"Authorization": "Token <API_TOKEN>"}
#   - "Bearer"  → results in: {"Authorization": "Bearer <API_TOKEN>"}
#   - "X-API-Key" → results in: {"X-API-Key": "<API_TOKEN>"}
#   - "none" → no authentication header will be sent
AUTH_SCHEME="Token"

# ==============================
# Documentation File
# ==============================

# Name of the JSON OpenAPI documentation file to load (without extension).
# The file must be a valid JSON file located inside the ./Files directory.
# If the file does not exist or this value is set to None,
# you can instead provide a link to a publicly available OpenAPI specification
# directly in the chat when prompted.
# Defaults to "documentation" if not specified.
DOCUMENTATION_FILE="documentation"

